# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://admin:password123@localhost:5432/miapp_db?schema=public"

# Servidor
PORT=3000
HOST="0.0.0.0"

# Secretos criptográficos para Autenticación
JWT_SECRET="framashare-jwt-super-secret-key-change-in-production"
COOKIE_SECRET="framashare-cookie-super-secret-key-change-in-production"

# Configuración de Correo Electrónico (SMTP)
# En local se puede usar un capturador local (Mailpit/Mailhog en puerto 1025) o credenciales SMTP reales
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FramaShare <no-reply@framashare.local>"

# URL base del Frontend (utilizada para construir los enlaces de reseteo de contraseña)
FRONTEND_URL="http://localhost:5173"

