DATABASE_URL="postgresql://admin:password123@127.0.0.1:5432/miapp_db?schema=public"
HOST=127.0.0.1
PORT=3000

# Must match the browser origin (use 127.0.0.1 if opening Vite there).
APP_ORIGIN=http://localhost:5173
# Private directory outside the web root; required explicitly in production.
STORAGE_PATH=./uploads
MAX_FILE_SIZE=100000000
# NODE_ENV=production requires an HTTPS APP_ORIGIN.

# Local test SMTP receiver. Production must set explicit host and sender.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
FROM_EMAIL="FramaShare <noreply@framashare.local>"
# SMTP_USER=
# SMTP_PASS=
