{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "dev:legacy": "concurrently \"npm run dev -w front\" \"npm run dev -w back\"",
    "install:all": "cd front; npm install | cd back; npm install"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@lucide/vue": "^1.52.0",
    "epubjs": "^0.3.93",
    "mupdf": "^1.28.1",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.12"
  }
}