{
  "name": "framashare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "dev:legacy": "concurrently \"npm run dev -w front\" \"npm run dev -w back\"",
    "install:all": "cd front; npm install | cd back; npm install"
  },
  "dependencies": {
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "lucide-vue-next": "^0.468.0",
    "pdfjs-dist": "^5.4.296",
    "@fontsource/figtree": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/literata": "^5.2.8"
  },
  "devDependencies": {
    "vite": "^7.1.9",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.1.1",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.56.0",
    "pdf-lib": "^1.17.1",
    "@types/node": "^24.6.0",
    "concurrently": "^10.0.5"
  },
  "workspaces": [
    "front",
    "back"
  ]
}
